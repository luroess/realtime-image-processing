#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TESTBENCH_DIR="$ROOT_DIR/testbench"

cd "$TESTBENCH_DIR"

if ! command -v uv >/dev/null 2>&1; then
  echo "Required dependency 'uv' not found in PATH." >&2
  exit 1
fi

uv sync

echo "Running quick test tier (fast): test_pipeline_fast.py"
export TB_STRESS_TARGETS="${TB_STRESS_TARGETS:-axi_rgb_to_grayscale,window_generator,axi_sobel_filter}"
uv run pytest -q -m fast pytest/test_pipeline_fast.py
