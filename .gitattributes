# Normalize line endings for all text files in this repository.
* text=auto eol=lf

# Keep common Windows script formats with CRLF when needed.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat generated waveform/object artifacts and images as binary.
*.ghw binary
*.cf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Vivado
# Vivado source files
*.vhd  text eol=lf
*.v    text eol=lf
*.sv   text eol=lf
*.tcl  text eol=lf
*.xdc  text eol=lf
*.qsys text eol=lf
*.xci  text eol=lf
*.xml  text eol=lf
