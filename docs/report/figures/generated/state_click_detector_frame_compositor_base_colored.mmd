stateDiagram-v2
  direction LR

  state "ST_RGB
o_pass_grayscale = 1
o_overlay_zeros = 0
o_led[3] = 0" as ST_RGB

  state "ST_GRAY
o_pass_grayscale = 0
o_overlay_zeros = 0
o_led[3] = 1" as ST_GRAY

  state "ST_ZEROS
o_pass_grayscale = 0
o_overlay_zeros = 1
o_led[3] = 0" as ST_ZEROS

  [*] --> ST_ZEROS: reset<br/>(i_rst_n = 0)
  ST_RGB --> ST_GRAY: BTN2↑<br/>∧ proc = ST_PASS_ALL
  ST_GRAY --> ST_RGB: BTN2↑<br/>∧ proc = ST_PASS_ALL
  ST_GRAY --> ST_ZEROS: BTN2↑<br/>∧ proc ≠ ST_PASS_ALL
  ST_ZEROS --> ST_RGB: BTN2↑<br/>∧ proc ≠ ST_PASS_ALL
  note right of ST_ZEROS
    proc ≠ ST_PASS_ALL
    includes proc = ST_BLUR
    ⇒ force ST_ZEROS
    o_overlay_zeros = 1
    o_pass_grayscale = 0
  end note

  classDef rgb fill:#dbeafe,stroke:#1d4ed8,color:#0b1f44,stroke-width:2px
  classDef gray fill:#bfdbfe,stroke:#1d4ed8,color:#0b1f44,stroke-width:2px
  classDef zero fill:#93c5fd,stroke:#1d4ed8,color:#0b1f44,stroke-width:2px
  class ST_RGB rgb
  class ST_GRAY gray
  class ST_ZEROS zero
