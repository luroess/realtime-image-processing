# =============================================================================
# Python / cocotb / pytest
# =============================================================================
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
*.eff-info/
*.pyc

# cocotb build + results
sim_build/
**/sim_build/
results.xml
*.result.xml

# =============================================================================
# HDL Simulator Artifacts (GHDL / NVC / Questa / Verilator / XSIM)
# =============================================================================
# Libraries / objects
work/
work-obj*.cf
*obj*.cf
*.o
e~*.o

# Waveforms
*.ghw
*.fst
*.vcd
*.vcd.gz
*.gtkw
*.wlf

# Simulation outputs
sim/work/
sim/*.log

# =============================================================================
# Vivado / Xilinx Generated Files
# =============================================================================
# Global Vivado
.Xil/
*.jou
*.log
*.str
*.pb
*.rpx
*.tmp
*.rst
*.debug

# Vivado project internals (all locations)
**/*.cache/
**/*.runs/
**/*.sim/
**/*.gen/
**/*.hw/
**/*.sdk/
**/*.ip_user_files/

# Vivado telemetry
webtalk*.jou
webtalk*.log
usage_statistics_webtalk.html
par_usage_statistics.html

# User-specific metadata
*.xpr.user

# IP integrator / handoff
ipshared/
hw_handoff/

# =============================================================================
# Vivado Project Tree (strict)
# =============================================================================
vivado/**/*.cache/
vivado/**/*.runs/
vivado/**/*.sim/
vivado/**/*.gen/
vivado/**/*.hw/
vivado/**/*.ip_user_files/
vivado/**/*.jou
vivado/**/*.log
vivado/**/.Xil/

# Block Design & IP output (generated)
vivado/**/*.srcs/**/ip/
# vivado/**/*.srcs/**/bd/
vivado/**/*.srcs/**/hdl/
vivado/**/*.srcs/**/sim/

# Track block design sources
!vivado/**/*.srcs/**/bd/

# IP repositories / vendor IP
vivado/**/repo/

# =============================================================================
# IP Build Outputs
# =============================================================================
ip/**/generated/
ip/**/synth/
ip/**/impl/
ip/**/sim/
ip/**/*.log

# =============================================================================
# FPGA Build Artifacts
# =============================================================================
*.bit
*.bin
*.ltx
*.dcp
*.rpt
*.mcs
*.prm

# =============================================================================
# Legacy Xilinx ISE / ISim (if present)
# =============================================================================
_xmsgs/
iseconfig/
xlnx_auto_0_xdb/
xst/
isim/

# =============================================================================
# OS / Editor
# =============================================================================
.DS_Store
Thumbs.db
*.swp
.vscode/

# =============================================================================
# CI / Temp
# =============================================================================
*.tmp
*.bak
*.old

# =============================================================================
# Ausnahmen für getrackte „locked“ IPs
# =============================================================================

# Zuerst übergeordnete Ordner freigeben
!vivado/hw.ipdefs/repo/
!vivado/hw.ipdefs/repo/local/
!vivado/hw.ipdefs/repo/local/ip/
!vivado/hw.ipdefs/repo/vivado-library/
!vivado/hw.ipdefs/repo/vivado-library/ip/

# Dann gezielt die IPs freigeben
!vivado/hw.ipdefs/repo/local/ip/AXI_BayerToRGB/
!vivado/hw.ipdefs/repo/local/ip/AXI_BayerToRGB/**

!vivado/hw.ipdefs/repo/local/ip/AXI_GammaCorrection/
!vivado/hw.ipdefs/repo/local/ip/AXI_GammaCorrection/**

!vivado/hw.ipdefs/repo/vivado-library/ip/MIPI_D_PHY_RX/
!vivado/hw.ipdefs/repo/vivado-library/ip/MIPI_D_PHY_RX/**

!vivado/hw.ipdefs/repo/vivado-library/ip/MIPI_CSI_2_RX/
!vivado/hw.ipdefs/repo/vivado-library/ip/MIPI_CSI_2_RX/**
